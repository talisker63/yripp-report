rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        (request.auth.token.roles != null && request.auth.token.roles.hasAny(['staff']))
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.roles != null && request.auth.token.roles.hasAny(['admin']))
      );
    }
    
    function hasAdminRole() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.roles != null && request.auth.token.roles.hasAny(['admin']))
      );
    }
    
    function isReportOwner() {
      return isAuthenticated() && 
             request.auth.uid == resource.data.metadata.ipId;
    }
    
    function canOwnerRead() {
      return isAuthenticated() && 
             isReportOwner() &&
             resource.data.metadata.submitted == false;
    }
    
    function canStaffRead() {
      return isAuthenticated() && 
             isStaff() &&
             (resource.data.metadata.submitted == true || isReportOwner());
    }
    
    function isValidReport() {
      let data = request.resource.data;
      return data.keys().hasAll(['sectionA', 'metadata']) &&
             data.metadata.keys().hasAll(['createdAt', 'updatedAt', 'draft', 'submitted']);
    }
    
    match /interviewReports/{reportId} {
      allow create: if isAuthenticated() && 
                       isValidReport() &&
                       request.resource.data.metadata.ipId == request.auth.uid &&
                       request.resource.data.metadata.submitted == false;
      
      allow read: if canOwnerRead() || canStaffRead();
      
      allow list: if isAuthenticated();
      
      allow update: if isAuthenticated() && (
                       (isReportOwner() &&
                        resource.data.metadata.submitted == false &&
                        request.resource.data.metadata.ipId == resource.data.metadata.ipId &&
                        request.resource.data.metadata.createdAt == resource.data.metadata.createdAt) ||
                       (isStaff() &&
                        resource.data.metadata.submitted == true &&
                        request.resource.data.metadata.ipId == resource.data.metadata.ipId &&
                        request.resource.data.metadata.createdAt == resource.data.metadata.createdAt &&
                        (request.resource.data.metadata.editHistory != null ||
                         request.resource.data.metadata.deleted != null))
                    );
      
      allow delete: if isAuthenticated() && (
                       (isReportOwner() && resource.data.metadata.submitted == false && !isAdmin())
                    );
    }
    
    match /reportSummaries/{reportId} {
      allow read: if isAuthenticated() && (
                      (resource.data.ipId == request.auth.uid) ||
                      (isStaff() && resource.data.submitted == true)
                   );
      
      allow list: if isAuthenticated();
      
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll([
                         'id', 'ipId', 'submitted', 'draft', 'updatedAt', 'createdAt',
                         'interviewDate', 'independentPersonName', 'policeStation', 'editHistoryCount', 'deleted'
                       ]) &&
                       (
                         request.resource.data.ipId == request.auth.uid ||
                         (isStaff() && request.resource.data.submitted == true)
                       );
      
      allow update: if isAuthenticated() && (
                       (resource.data.ipId == request.auth.uid &&
                        request.resource.data.ipId == resource.data.ipId) ||
                       (isStaff() &&
                        resource.data.submitted == true &&
                        request.resource.data.ipId == resource.data.ipId)
                    );
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (
                      request.auth.uid == userId ||
                      hasAdminRole()
                   );
      allow list: if isAuthenticated() && hasAdminRole();
      allow create: if isAuthenticated() && (
                      request.auth.uid == userId &&
                      request.resource.data.keys().hasAll(['email', 'name', 'roles', 'createdAt', 'updatedAt'])
                   );
      allow update: if isAuthenticated() && (
                      (request.auth.uid == userId && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phoneNumber', 'updatedAt'])) ||
                      hasAdminRole()
                   );
    }
    
    match /auditLogs/{logId} {
      allow read: if isStaff() || hasAdminRole();
      allow create: if isAuthenticated();
    }
  }
}
